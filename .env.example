# ============================================================================
# MDC Daily — configuration
# Copy this file to ".env" and fill in the values. NEVER commit your real .env.
# The monday token is the only long-lived secret stored here; the Outlook
# refresh token is kept in the Windows Credential Manager, not in this file.
# ============================================================================

# ---- monday.com ------------------------------------------------------------
# Personal API token: monday.com -> your avatar (bottom left) -> Developers
#   -> "My access tokens" -> Show / Generate. Paste it here.
MONDAY_API_TOKEN=
# Fixed values for Ryan's board — no need to change these.
MONDAY_BOARD_ID=18417698484
MONDAY_USER_ID=100030091
MONDAY_API_VERSION=2024-10

# ---- Microsoft 365 / Outlook (Microsoft Graph) -----------------------------
# From the Azure app registration you create (see README "Outlook setup").
# These two are NOT secrets (public client, no client secret is used).
MS_CLIENT_ID=
MS_TENANT_ID=mcmillanlv.com
# Auth flow: "devicecode" (simplest, paste a code in a browser) or
# "authcode" (opens a browser window with PKCE, redirect http://localhost).
MS_AUTH_FLOW=devicecode

# ---- Sync behaviour --------------------------------------------------------
# Background sync interval in minutes (you chose 60). Sync-on-launch and the
# manual "Sync now" button always work regardless of this value.
SYNC_INTERVAL_MINUTES=60
# How many days of Inbox / Sent Items to scan for email tasks.
EMAIL_LOOKBACK_DAYS=7

# ---- Write-back (DEFAULTS OFF — you chose read-only) -----------------------
# When false, checking a task off only persists locally; nothing is ever
# written to monday or Outlook. Flip to true only if you later want write-back.
# Every mutation is appended to mutation-audit.log regardless.
MONDAY_WRITEBACK=false
OUTLOOK_WRITEBACK=false

# ---- Notifications ---------------------------------------------------------
# One digest notification per day when something newly becomes overdue.
NOTIFY_ON_OVERDUE=true

# ---- Autostart -------------------------------------------------------------
# Start MDC Daily automatically when Windows starts.
START_WITH_WINDOWS=true
