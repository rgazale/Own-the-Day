{
  "name": "mdc-daily",
  "productName": "MDC Daily",
  "version": "1.0.0",
  "description": "One always-current list of every work task assigned to Ryan Gazale, merged from monday.com, Outlook, and manual entries.",
  "author": "MDC Low Voltage Systems",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "prove:monday": "node scripts/prove-monday.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "dotenv": "^16.4.5",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mcmillanlv.mdcdaily",
    "productName": "MDC Daily",
    "asar": false,
    "extraResources": [
      { "from": "config", "to": "config" }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MDC Daily"
    }
  }
}
